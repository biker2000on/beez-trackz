# --- Go API (backend/) ---
LISTEN_ADDR=:8080
DATABASE_URL=postgresql://beeztrackz:beeztrackz@localhost:5432/beeztrackz
REDIS_URL=redis://localhost:6379

# MinIO media storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=beeztrackz
MINIO_SECRET_KEY=beeztrackz
MINIO_USE_SSL=false
MINIO_BUCKET=beeztrackz-media

# Photo originals (optional Immich). Unset PHOTO_STORAGE_BACKEND means
# Immich if both URL and key are set, otherwise MinIO. Audio stays MinIO-only.
# PHOTO_STORAGE_BACKEND=minio
# IMMICH_BASE_URL=https://photos.example
# IMMICH_API_KEY=

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# OIDC (optional — e.g. Pocket ID)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# AI providers are configured in-app (settings) — no env vars needed.
# Local Whisper transcription (speaches); defaults to the compose service.
WHISPER_URL=http://localhost:8000

# --- Next.js web app (frontend/) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
